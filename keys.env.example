# The real keys file lives outside this project folder, where git never sees it.
#
#   Windows:          %USERPROFILE%\.spindle\keys.env
#   macOS and Linux:  ~/.spindle/keys.env
#
# Set SPINDLE_KEYS_FILE to keep it somewhere else. Copy this file to that place,
# then put a real key after each name. Leave a name out and the models behind
# it show "add a key: see keys.env.example"; the Mock model needs no key.

# Claude and GPT, both reached through OpenRouter.
OPENROUTER_API_KEY=your-openrouter-key-goes-here

# The NVIDIA model.
NVIDIA_API_KEY=your-nvidia-key-goes-here
